APP_ENV=development
DEMO_ENABLED=true
DATABASE_PATH=data/reprep.sqlite3
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-flash
AI_SYNTHETIC_ONLY=true
AI_DATA_APPROVED=false
AI_DAILY_LIMIT=50

# Blank OPENROUTER_MODEL selects transparent local rules (not neural AI).
# Never enable demo accounts on a public production instance.

# MAX: disabled until owner authorizes registration and external deployment.
PUBLIC_BASE_URL=
MAX_BOT_ID=0
MAX_BOT_ENABLED=false
MAX_OUTBOUND_ENABLED=false
MAX_WEBHOOK_SECRET=
MAX_CA_BUNDLE=
MAX_BOT_TOKEN=

# Enable real guardian sharing only after access/consent policy approval
GUARDIAN_DATA_APPROVED=false

# Operator-only erasure; keep disabled until the retention/access policy is approved
ACCOUNT_DELETION_APPROVED=false
